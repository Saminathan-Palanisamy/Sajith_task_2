            "text": "1.1",
            "style": "H3"
        },
        {
            "text": "This document establishes the requirements for XYZ at Inmar, Inc. and its wholly and",
            "style": "H3"
        },
        {
            "text": "partially owned subsidiaries (collectively referred to as “Inmar”).",
            "style": "H3"
        },
        {
            "text": "2.0",
            "style": "H3"
        },
        {
            "text": "Scope",
